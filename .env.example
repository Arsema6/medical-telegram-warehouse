# Copy this file to .env and replace placeholders.
# Never commit a real .env file.

# --- PostgreSQL ---
# Used by the API, loaders, dbt, and Docker Compose.
DB_HOST=localhost
DB_PORT=5432
DB_USER=warehouse
DB_PASSWORD=warehouse
DB_NAME=medical_warehouse

# Optional dbt schema (models are built here).
DBT_SCHEMA=public
DBT_TARGET=dev

# --- API security ---
# Required for analytics endpoints. Health and OpenAPI docs stay public.
# Generate a long random value before any network exposure.
API_KEY=dev-api-key-change-me

# Requests per client IP per minute for /api/* routes.
API_RATE_LIMIT_PER_MINUTE=60

# --- Telegram (optional for the demo) ---
# Required only when running src.scraper against live channels.
# Create an app at https://my.telegram.org and keep credentials private.
API_ID=
API_HASH=
TELEGRAM_SESSION_PATH=session
# Max messages pulled per channel per scrape run.
TELEGRAM_MESSAGE_LIMIT=200

# Set to 1 to skip YOLO in the Dagster job (demo / CI without GPU/torch).
SKIP_YOLO=1

# Logging: info|debug|warning|error
LOG_LEVEL=info
